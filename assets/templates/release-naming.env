# Copy to repo root and customize.
# Source of truth for release naming used by docs/scripts/workflows.

CLI_NAME=your-cli
BINARY_NAME=your-cli
TAG_PREFIX=v
ARTIFACT_GLOB=your-cli-*.tar.gz
BUILD_TARGET=./cmd/your-cli

# Full package path to the Version variable for ldflags embedding
VERSION_VAR_PATH=github.com/your-org/your-repo/pkg/version.Version
